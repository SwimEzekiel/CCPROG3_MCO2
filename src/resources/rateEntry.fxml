<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="300.0" prefWidth="500.0" style="-fx-background-color: #545454;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxmlControllers.RateController">
   <children>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#636b2f" height="32.0" stroke="BLACK" strokeType="INSIDE" width="500.0" />
      <Label fx:id="titleLabel" layoutX="14.0" layoutY="4.0" text="Give a rating!" textFill="WHITE">
         <font>
            <Font name="Impact" size="20.0" />
         </font>
      </Label>
      <TextArea fx:id="reviewArea" layoutX="20.0" layoutY="92.0" prefHeight="153.0" prefWidth="459.0" promptText="Write your review here!" />
      <Spinner fx:id="ratingSpinner" layoutX="191.0" layoutY="58.0" prefHeight="25.0" prefWidth="228.0" />
      <Button fx:id="reviewButton" layoutX="213.0" layoutY="257.0" mnemonicParsing="false" onAction="#giveReview" style="-fx-background-color: #636b2f;" text="Give review" textFill="WHITE" underline="true">
         <font>
            <Font name="Impact" size="12.0" />
         </font>
      </Button>
      <Label layoutX="81.0" layoutY="60.0" text="Rating over 10:" textFill="WHITE">
         <font>
            <Font name="Impact" size="16.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
