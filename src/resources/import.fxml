<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="150.0" prefWidth="300.0" style="-fx-background-color: #545454;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxmlControllers.ImportController">
   <children>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#636b2f" height="32.0" layoutY="-2.0" stroke="BLACK" strokeType="INSIDE" width="300.0" />
      <Label layoutX="14.0" layoutY="2.0" text="Import collection" textFill="WHITE">
         <font>
            <Font name="Impact" size="20.0" />
         </font>
      </Label>
      <Button fx:id="selectButton" layoutX="29.0" layoutY="49.0" mnemonicParsing="false" onAction="#selectFile" prefHeight="48.0" prefWidth="241.0" style="-fx-background-color: #b4b4b4;" text="Select file...">
         <font>
            <Font name="Impact" size="18.0" />
         </font>
      </Button>
      <Button layoutX="119.0" layoutY="107.0" mnemonicParsing="false" onAction="#importFile" style="-fx-background-color: #636b2f;" text="Import" textFill="WHITE" underline="true">
         <font>
            <Font name="Impact" size="15.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
